# TMDB (free catalog data, via Cloudflare Worker proxy)
TMDB_PROXY_URL=https://tmdb-proxy.<cloudflare_domain>.workers.dev
TMDB_PROXY_SECRET=your_tmdb_proxy_secret

# Radarr (movie management)
RADARR_URL=http://your-oracle-vm:7878
RADARR_API_KEY=your_radarr_api_key_here

# Sonarr (TV series management)
SONARR_URL=http://your-oracle-vm:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Jellyfin (media streaming)
JELLYFIN_URL=http://your-oracle-vm:8096
JELLYFIN_USERNAME=your_jellyfin_username
JELLYFIN_PASSWORD=your_jellyfin_password
# Optional Jellyfin API key and system user ID for system-level fallback flows
JELLYFIN_API_KEY=
JELLYFIN_SYSTEM_USER_ID=
# Silent automated Jellyfin re-authentication gate (0 = off/disabled, 1 = on)
JELLYFIN_ENV_REAUTH=0
# Optional comma-separated list of allowed custom Jellyfin server origins for login
JELLYFIN_SERVER_ALLOWLIST=

# Security & Proxy Settings
# Public image proxies (0 = require session for all images, 1 = allow unauthenticated Jellyfin poster artwork)
ALLOW_PUBLIC_IMAGES=0
# CSRF protection (0 = enforce Origin/Referer check on mutations, 1 = allow insecure/non-browser clients)
CSRF_INSECURE_CLIENTS_ALLOWED=0
# Reverse proxy trust for audit logs (1 = use rightmost X-Forwarded-For entry)
TRUSTED_PROXY=1
# Optional custom HTTP header for client IP extraction (e.g., X-Umr-Client-IP)
CLIENT_IP_HEADER=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Self-Hosted Convex Backend (optional watchlist & session persistence)
CONVEX_SELF_HOSTED_URL=http://localhost:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=your_convex_admin_key_here

# qBittorrent (download monitoring)
QBITTORRENT_URL=http://your-oracle-vm:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Webhook auth (recommended) — protects /api/webhooks from unauthorized notification writes.
# When set, Radarr/Sonarr webhooks must send it via the "x-webhook-secret" header (or ?secret=).
WEBHOOK_SECRET=change_me_to_a_long_random_string

# Notification pipeline debug logs (optional) — set to 1 to tail the notification pipeline.
# WARNING: logs user IDs, usernames and admin IDs; keep off in production.
NOTIF_DEBUG=0
