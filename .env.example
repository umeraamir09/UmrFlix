# Copy this file to .env in the same folder as docker-compose.yml
# then fill in your real values. Run `cp .env.example .env`

# --- User/Group IDs ---
# Run `id $USER` on your VM to get these. Using your real user's
# IDs (not root/0) avoids permission headaches on mounted folders.
PUID=1000
PGID=1000

# --- Timezone ---
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Karachi

# --- Storage ---
# Root path on the host where media + downloads live.
# Media and torrents/downloads should be on the SAME filesystem/mount
# so Sonarr/Radarr can hardlink instead of copying files (saves space,
# instant imports). Adjust to match your actual Oracle Cloud block
# volume mount point.
DATA_ROOT=/mnt/data

# --- Nginx Proxy Manager integration (optional) ---
# The Docker network name your existing NPM instance's container is
# attached to. Find it with: docker network ls
# and: docker inspect <npm_container_name> --format '{{json .NetworkSettings.Networks}}'
# If you're not using NPM, you can leave this blank.
NPM_NETWORK_NAME=npm_proxy_network

# --- Postgres (UmrFlix database) ---
POSTGRES_USER=umrflix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=umrflix
# App runs on the host; inside media_internal use postgres instead of 127.0.0.1.
# URL-encode special characters in the password. Keep this server-side.
DATABASE_URL=postgresql://umrflix:change-me@127.0.0.1:5432/umrflix

# TMDB (required for catalog data; API key or API Read Access Token)
TMDB_API_KEY=your_tmdb_api_key

# Radarr (movie management)
RADARR_URL=http://your-domain-or-host:7878
RADARR_API_KEY=your_radarr_api_key_here

# Sonarr (TV series management)
SONARR_URL=http://your-domain-or-host:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Jellyfin (media streaming)
JELLYFIN_URL=http://your-domain-or-host:8096
JELLYFIN_USERNAME=your_jellyfin_username
JELLYFIN_PASSWORD=your_jellyfin_password
# Optional Jellyfin API key and system user ID for system-level fallback flows
JELLYFIN_API_KEY=
JELLYFIN_SYSTEM_USER_ID=
# Silent automated Jellyfin re-authentication gate (0 = off/disabled, 1 = on)
JELLYFIN_ENV_REAUTH=0
# Optional comma-separated list of allowed custom Jellyfin server origins for login
JELLYFIN_SERVER_ALLOWLIST=

# Security & Proxy Settings
# Public image proxies (0 = require session for all images, 1 = allow unauthenticated Jellyfin poster artwork)
ALLOW_PUBLIC_IMAGES=0
# CSRF protection (0 = enforce Origin/Referer check on mutations, 1 = allow insecure/non-browser clients)
CSRF_INSECURE_CLIENTS_ALLOWED=0
# Reverse proxy trust for client identity/rate limits (1 = use a validated rightmost X-Forwarded-For entry)
TRUSTED_PROXY=1
# Optional custom HTTP header for validated client IP extraction (e.g., X-Umr-Client-IP)
CLIENT_IP_HEADER=

# OMDB (optional IMDb ratings enrichment - falls back to TMDB ratings when unset)
OMDB_API_KEY=your_omdb_api_key_here

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# qBittorrent (download monitoring)
QBITTORRENT_URL=http://your-domain-or-host:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Webhook auth (recommended) — protects /api/webhooks from unauthorized notification writes.
# When set, Radarr/Sonarr webhooks must send it via the "x-webhook-secret" header (or ?secret=).
WEBHOOK_SECRET=change_me_to_a_long_random_string

# Notification pipeline debug logs (optional) — set to 1 to tail the notification pipeline.
# WARNING: logs user IDs, usernames and admin IDs; keep off in production.
NOTIF_DEBUG=0
